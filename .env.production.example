# Copia este fichero a ".env" en el servidor de producción doméstico y ajusta los valores
# marcados. Luego: docker compose -f docker-compose.yml -f docker-compose.tunnel.yml up -d
#
# Este fichero NO sustituye a .env.example — es .env.example con los valores que necesita un
# despliegue doméstico real detrás de un dominio propio y un Cloudflare Tunnel. Si algo no
# aparece aquí explicado, la explicación completa está en .env.example.
#
# ══════════════════════════════════════════════════════════════════════════════════════════
#  AVISO — LEE ESTO ANTES DE LEVANTAR EL SERVIDOR
#  Cambiar RP_ID más tarde invalida TODAS las passkeys ya registradas (quedan atadas al
#  hostname antiguo y el navegador las rechaza). Decide el dominio definitivo AHORA, antes de
#  crear ningún perfil. Si aún no tienes el dominio comprado y el túnel de Cloudflare creado,
#  para aquí y hazlo primero — ver docs/DESPLIEGUE.md, pasos 1 y 2.
# ══════════════════════════════════════════════════════════════════════════════════════════

# ── Dominio y passkeys (OBLIGATORIO — edita esto) ──────────────────────────────────────────
# Sustituye gym.EJEMPLO.com por tu dominio real. RP_ID es solo el hostname (sin esquema, sin
# puerto, sin ruta); ORIGIN es la URL completa con https://.
RP_ID=gym.EJEMPLO.com
ORIGIN=https://gym.EJEMPLO.com
WEB_PORT=8080
RP_NAME=openGym

# ── Túnel de Cloudflare (lo usa docker-compose.tunnel.yml, NO lo lee la app) ───────────────
# El contenedor `cloudflared` de la superposición docker-compose.tunnel.yml lee esta variable
# para autenticarse contra tu túnel y sacar tráfico hacia el servicio `web` por la red interna
# de Docker Compose. api/server.js no la usa para nada — es exclusiva del túnel.
#
# Cómo conseguirla: en el dashboard de Cloudflare Zero Trust, Networks → Tunnels → crea un
# túnel de tipo "Cloudflare Connector" (o `cloudflared tunnel create` por CLI), añade una
# ruta pública (public hostname) que apunte tu dominio a http://web:80 (el puerto interno del
# contenedor web, NGINX_PORT — no WEB_PORT), y copia el token que te da la pantalla de
# instalación ("Docker" como método). Es una cadena larga, un solo valor:
#
#   TUNNEL_TOKEN=eyJhIjoixxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx...
#
TUNNEL_TOKEN=

# ── Admin dashboard (recomendado en un despliegue doméstico real) ──────────────────────────
# Vacío en el primer arranque a propósito: no puedes saber tu propio uid hasta haber creado tu
# perfil. Sigue el orden de docs/DESPLIEGUE.md (paso 4): levanta el servidor, crea tu perfil
# desde el móvil, busca tu id en ./data/db.json ("users"[].id), ponlo aquí y reinicia.
#
#   ADMIN_UIDS=tuUserId
ADMIN_UIDS=

# ── Puerta de entrada: solo perfiles, sin invitados ────────────────────────────────────────
# Esto es tu instancia personal/familiar, no una abierta al público: fuera el botón de
# "Continuar sin cuenta". Quien entre, entra con un perfil de verdad.
ALLOW_GUEST=0

# ── Registro de actividad ───────────────────────────────────────────────────────────────────
# Encendido: en un servidor accesible desde internet (aunque sea solo tú quien lo usa), tener
# quién entró y cuándo cuesta nada y ayuda el día que algo raro pasa.
AUDIT_LOG=1

# ── Sesión larga ─────────────────────────────────────────────────────────────────────────────
# 365 días: es tu propio servidor, en tu propia casa, para tu propia familia — no tiene sentido
# volver a pasar por el passkey cada 90 días como en una instancia abierta. Si alguna vez
# quieres cerrar todas las sesiones a la vez (móvil robado, etc.), usa "Sign out everywhere" en
# Ajustes en vez de bajar este número.
SESSION_DAYS=365

# ── El resto de variables opcionales de .env.example (INVITE_ONLY, AUDIT_MAX, AUDIT_DAYS,
#    AUDIT_IP, NGINX_PORT, BACKEND, PORT, VAPID_SUBJECT) se dejan en sus valores por defecto.
#    Cámbialas solo si sabes que las necesitas — están documentadas en .env.example.
